<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#f9f9f9">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PowerFix Field Worker"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1a1c1c"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duty status, assigned breakdowns, and live progress"
        android:textSize="13sp"
        android:textColor="#5b4039"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/availabilityButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="⚡ Mark Duty Availability"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#006E1C"
        android:textColor="#ffffff"/>

    <Button
        android:id="@+id/viewAssignedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📋 View Assigned Work Orders"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF5722"
        android:textColor="#ffffff"/>

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Sign Out"
        android:textAllCaps="false"
        android:backgroundTint="#546E7A"
        android:textColor="#ffffff"/>

</LinearLayout>
