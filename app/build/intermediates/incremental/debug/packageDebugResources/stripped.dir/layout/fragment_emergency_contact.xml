<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f9f9f9"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency Contact"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1a1c1c"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send a request and view admin replies"
        android:textColor="#5b4039"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/messageInput"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:hint="Describe the emergency request"
        android:gravity="top|start"
        android:background="#f3f3f3"
        android:padding="12dp"
        android:layout_marginBottom="20dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/sendRequestButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Send Request"
            android:textAllCaps="false"
            android:backgroundTint="#b02f00"
            android:textColor="#ffffff"/>

        <ProgressBar
            android:id="@+id/sendProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#b02f00"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
